{
  "slug": "audio-dubbing-pipeline",
  "title": "Multi-Language Audio Dubbing Pipeline",
  "description": "Download a YouTube video, transcribe it, translate into multiple languages, generate dubbed audio with ElevenLabs TTS, and replace the original audio track, fully automated with nested forEach loops.",
  "author": "Graph Compose Team",
  "tags": ["video", "audio", "translation", "elevenlabs", "openai", "forEach"],
  "difficulty": "advanced",
  "publishedAt": "2026-03-15",
  "imageSrc": "/images/recipes/audio-dubbing-pipeline-header.svg",
  "imageAlt": "Workflow graph showing a multi-language audio dubbing pipeline",
  "requiredSecrets": ["OPENAI_API_KEY", "ELEVENLABS_API_KEY"],
  "requiredServices": ["Graph Compose Nodes Service", "OpenAI API", "ElevenLabs API"],
  "relatedRecipes": ["ai-content-pipeline"],
  "relatedBlogPosts": [],
  "workflow": {
    "workflowConfig": {
      "workflowExecutionTimeout": "120 minutes"
    },
    "context": {
      "youtubeUrl": "https://www.youtube.com/watch?v=REPLACE_ME",
      "openaiApiKey": "{{ secrets.OPENAI_API_KEY }}",
      "elevenlabsApiKey": "{{ secrets.ELEVENLABS_API_KEY }}"
    },
    "nodes": [
      {
        "id": "download_video",
        "type": "http",
        "dependencies": [],
        "activityConfig": {
          "startToCloseTimeout": "10 minutes",
          "scheduleToCloseTimeout": "15 minutes",
          "retryPolicy": { "maximumAttempts": 2, "initialInterval": "10s" }
        },
        "http": {
          "method": "POST",
          "url": "http://localhost:3009/nodes/ytdl/download",
          "body": {
            "url": "{{ context.youtubeUrl }}",
            "format": "mp4",
            "quality": "highest"
          }
        }
      },
      {
        "id": "extract_audio",
        "type": "http",
        "dependencies": ["download_video"],
        "activityConfig": {
          "startToCloseTimeout": "5 minutes",
          "scheduleToCloseTimeout": "10 minutes"
        },
        "http": {
          "method": "POST",
          "url": "http://localhost:3009/nodes/video/audio-extraction",
          "body": {
            "videoUrl": "{{ results.download_video.data.data.task_result.url }}"
          }
        }
      },
      {
        "id": "transcribe_audio",
        "type": "http",
        "dependencies": ["extract_audio"],
        "activityConfig": {
          "startToCloseTimeout": "10 minutes",
          "scheduleToCloseTimeout": "15 minutes",
          "retryPolicy": { "maximumAttempts": 2, "initialInterval": "5s" }
        },
        "http": {
          "method": "POST",
          "url": "http://localhost:3009/nodes/openai/speech/transcribe",
          "body": {
            "apiKey": "{{ context.openaiApiKey }}",
            "audioUrl": "{{ results.extract_audio.data.data.audioUrl }}",
            "responseFormat": "verbose_json",
            "language": "en"
          }
        }
      },
      {
        "id": "chunk_transcript",
        "type": "http",
        "dependencies": ["transcribe_audio"],
        "activityConfig": {
          "startToCloseTimeout": "30s"
        },
        "http": {
          "method": "POST",
          "url": "http://localhost:3009/nodes/text/chunk",
          "body": {
            "segments": "{{ results.transcribe_audio.data.data.segments }}",
            "maxChars": 3500
          }
        }
      },
      {
        "id": "dub_langs",
        "type": "forEach",
        "dependencies": ["chunk_transcript"],
        "forEach": {
          "items": "{{ [ { \"lang\": \"Spanish\", \"code\": \"es\", \"voiceId\": \"21m00Tcm4TlvDq8ikWAM\" }, { \"lang\": \"French\", \"code\": \"fr\", \"voiceId\": \"pNInz6obpgDQGcFmaJgB\" } ] }}"
        }
      },
      {
        "id": "dub_chunks",
        "type": "forEach",
        "dependencies": ["dub_langs"],
        "forEach": {
          "items": "{{ results.chunk_transcript.data.data.chunks }}"
        }
      },
      {
        "id": "translate",
        "type": "http",
        "dependencies": ["dub_chunks"],
        "activityConfig": {
          "startToCloseTimeout": "60s",
          "retryPolicy": { "maximumAttempts": 2, "initialInterval": "5s" }
        },
        "http": {
          "method": "POST",
          "url": "http://localhost:3009/nodes/llm/query",
          "body": {
            "model": "openai/gpt-4o",
            "api_key": "{{ context.openaiApiKey }}",
            "system_prompt": "You are a professional dubbing translator. Translate the English transcript segment to the specified target language. Maintain natural speech patterns for TTS narration. Match the pacing and tone. Return only the translated text.",
            "message": "{{ 'Translate to ' & rows.dub_langs.data.lang & ':\\n\\n' & row.data.text }}",
            "temperature": 0.3,
            "max_tokens": 2000
          }
        }
      },
      {
        "id": "tts",
        "type": "http",
        "dependencies": ["translate"],
        "activityConfig": {
          "startToCloseTimeout": "3 minutes",
          "scheduleToCloseTimeout": "20 minutes",
          "retryPolicy": {
            "maximumAttempts": 6,
            "initialInterval": "30s",
            "backoffCoefficient": 2,
            "maximumInterval": "5 minutes"
          }
        },
        "http": {
          "method": "POST",
          "url": "http://localhost:3009/nodes/elevenlabs/tts/generate",
          "body": {
            "apiKey": "{{ context.elevenlabsApiKey }}",
            "text": "{{ results.translate.data.data.response }}",
            "voiceId": "{{ rows.dub_langs.data.voiceId }}",
            "modelId": "eleven_multilingual_v2",
            "outputFormat": "mp3_44100_128"
          }
        }
      },
      {
        "id": "end_dub_chunks",
        "type": "endForEach",
        "forEachId": "dub_chunks",
        "dependencies": ["tts"]
      },
      {
        "id": "concat_audio",
        "type": "http",
        "dependencies": ["end_dub_chunks"],
        "activityConfig": {
          "startToCloseTimeout": "15 minutes",
          "scheduleToCloseTimeout": "20 minutes"
        },
        "http": {
          "method": "POST",
          "url": "http://localhost:3009/nodes/audio/concat",
          "body": {
            "audioUrls": "{{ [$map(results.dub_chunks.data.items, function($item) { $item.results.tts.data.data.audioUrl })] }}",
            "targetDurations": "{{ [$map(results.dub_chunks.data.items, function($item) { $item.data.duration })] }}"
          }
        }
      },
      {
        "id": "replace_audio",
        "type": "http",
        "dependencies": ["concat_audio"],
        "activityConfig": {
          "startToCloseTimeout": "10 minutes",
          "scheduleToCloseTimeout": "15 minutes",
          "retryPolicy": { "maximumAttempts": 2, "initialInterval": "10s" }
        },
        "http": {
          "method": "POST",
          "url": "http://localhost:3009/nodes/video/replace-audio",
          "body": {
            "videoUrl": "{{ results.download_video.data.data.task_result.url }}",
            "audioUrl": "{{ results.concat_audio.data.data.audioUrl }}",
            "label": "{{ rows.dub_langs.data.code }}"
          }
        }
      },
      {
        "id": "end_dub_langs",
        "type": "endForEach",
        "forEachId": "dub_langs",
        "dependencies": ["replace_audio"]
      }
    ]
  }
}
