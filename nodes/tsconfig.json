{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "target": "ES2022",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "dom"],
    "baseUrl": ".",
    "types": [
      "node", "jest"
    ]
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
