{
  "name": "nodes-service",
  "scripts": {
    "lint": "eslint --ext .ts .",
    "build:watch": "tsc --watch",
    "build": "tsc",
    "test:openapi-contract:live": "STRICT_OPENAPI_CONTRACT=1 npx tsx --test src/tests/openapi-contract.live.test.ts",
    "format": "prettier --write .",
    "pre-commit": "pnpm install && pnpm lint && pnpm format && pnpm build",
    "start": "node lib/index.js",
    "dev": "PORT=3009 npx tsx watch src/index.ts",
    "clean": "rimraf lib"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/s3-request-presigner": "^3.782.0",
    "@google-cloud/storage": "^7.16.0",
    "@sendgrid/mail": "^8.1.4",
    "@slack/web-api": "^7.8.0",
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-zod-safe": "^1.3.3",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.2",
    "openai": "^4.91.0",
    "openapi-types": "^12.1.3",
    "papaparse": "^5.5.2",
    "replicate": "^1.0.1",
    "resend": "^3.4.0",
    "snoowrap": "^1.23.0",
    "source-map-support": "^0.5.21",
    "twilio": "^5.5.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2",
    "zod-openapi": "^4.2.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/form-data": "^2.5.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash": "^4.17.16",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.24",
    "@types/papaparse": "^5.3.15",
    "@types/stripe": "^8.0.416",
    "@types/twilio": "^3.19.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-plugin-promise": "^7.2.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.5.4"
  },
  "private": true
}
